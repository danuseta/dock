generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TicketCache {
  id String @id @default(uuid())
  key String @unique
  summary String
  description String?
  status String
  assignee String?
  reporter String?
  priority String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
}

model PullRequestCache {
  id String @id @default(uuid())
  number Int
  title String
  description String?
  state String
  url String
  author String
  repository String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mergedAt DateTime?
  @@unique([repository, number])
  @@index([repository])
  @@index([state])
}

model DemoLink {
  id String @id @default(uuid())
  ticketKey String @unique
  url String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketDependency {
  id           String   @id @default(uuid())
  ticketKey    String   @unique
  dependsOnKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([dependsOnKey])
}

/// A work order number set in DOCK; it wins over the ticket's "#N" Jira label. Never written to Jira.
model TicketOrder {
  ticketKey String   @id
  position  Int?
  /// The owner works this ticket by hand: the cron never picks or resumes it.
  manual    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model QuickLink {
  id String @id @default(uuid())
  title String
  url String
  color String @default("#60a5fa")
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([position])
}

model MonitorTarget {
  id             String    @id @default(uuid())
  name           String
  url            String
  expectedStatus Int       @default(200)
  timeoutMs      Int       @default(5000)
  lastStatus     String?
  lastStatusCode Int?
  lastLatencyMs  Int?
  lastCheckedAt  DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([name])
}

model AppSettings {
  id String @id @default(uuid())
  key String @unique
  value String
  description String?
  updatedAt DateTime @updatedAt
}

model CacheEntry {
  key String @id
  value String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([expiresAt])
}

model MonitoredRepository {
  id String @id @default(uuid())
  owner String
  name String
  webhookSecret String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([owner, name])
}

model OrchestratorRun {
  key              String    @id
  title            String    @default("")
  stage            String
  waiting          String    @default("")
  payload          String
  activity         String    @default("IDLE")
  activityDetail   String?
  activityEndedAt  DateTime?
  lastEventAt      DateTime?
  ledgerUpdatedAt  DateTime  @default(now())
  transcriptAt     DateTime?
  dismissedAt      DateTime?
  machine          String    @default("laptop")
  ledgerRaw        String?
  handover         String?
  jiraStatus       String?
  jiraStage        String?
  /// Why the run is stalled although its last turn just ended, e.g. a lead that left subagents running. Cleared when a new turn starts.
  stalledDetail    String?
  stalledAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([stage])
}

/// A run removed because its ticket went back to To Do in Jira. A ledger made before resetAt does not bring it back.
model OrchestratorReset {
  key     String   @id
  machine String
  resetAt DateTime @default(now())
}

model OrchestratorEvent {
  id        String   @id @default(uuid())
  ticketKey String
  kind      String
  detail    String?
  createdAt DateTime @default(now())

  @@index([ticketKey, createdAt])
}

model IngestToken {
  id         String    @id @default(uuid())
  name       String
  prefix     String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  machine    String    @default("laptop")
  createdAt  DateTime  @default(now())
}

model OrchestratorToolEvent {
  id        Int      @id @default(autoincrement())
  ticketKey String
  kind      String
  agentId   String   @default("main")
  agentType String?
  name      String
  detail    String?
  at        DateTime

  @@index([ticketKey, id])
}

model ChatSession {
  id              String    @id
  source          String
  machine         String    @default("laptop")
  title           String    @default("")
  ticketKey       String?
  forkFrom        String?
  claudeSessionId String?
  status          String    @default("idle")
  statusDetail    String?
  messageCount    Int       @default(0)
  startedAt       DateTime
  lastMessageAt   DateTime
  lastDeltaAt     DateTime?
  options         String?
  /// "cron" for a session the orchestrator cron opened (it takes a cron slot), "manual" otherwise.
  origin          String    @default("manual")
  /// The Claude account the bridge runs this session with; null runs it on the machine's active account.
  account         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([source, lastMessageAt])
  @@index([ticketKey])
  @@index([machine, status])
}

model ChatMessage {
  id              Int       @id @default(autoincrement())
  sessionId       String
  role            String
  text            String
  state           String    @default("done")
  at              DateTime
  options         String?
  takenAt         DateTime?
  stopRequestedAt DateTime?
  /// False for an owner reply or a review in a cron session: it waits only for Turns at once, not for a cron slot.
  cronSlot        Boolean   @default(true)

  @@index([sessionId, id])
  @@index([state])
}

model ChatActivity {
  id        Int       @id @default(autoincrement())
  sessionId String
  turnId    Int
  eventId   String
  parentId  String?
  kind      String
  agent     String    @default("main")
  name      String
  label     String    @default("")
  summary   String    @default("")
  detail    String?
  status    String    @default("running")
  seq       Int
  startedAt DateTime
  endedAt   DateTime?

  @@unique([sessionId, turnId, eventId])
  @@index([sessionId, seq])
  @@index([startedAt])
}

model ChatInteraction {
  id          Int       @id @default(autoincrement())
  sessionId   String
  turnId      Int
  requestId   String
  kind        String
  title       String    @default("")
  body        String
  state       String    @default("pending")
  answer      String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  answeredAt  DateTime?
  deliveredAt DateTime?

  @@unique([sessionId, turnId, requestId])
  @@index([sessionId, state])
  @@index([createdAt])
}

model ChatAttachment {
  id        String    @id
  sessionId String
  messageId Int?
  name      String
  mime      String
  size      Int
  sha256    String
  state     String    @default("uploaded")
  createdAt DateTime  @default(now())
  fetchedAt DateTime?

  @@index([sessionId, messageId])
  @@index([messageId])
  @@index([state, createdAt])
}

model ChatMachineInfo {
  machine     String   @id
  caps        String   @default("")
  catalog     String   @default("")
  catalogHash String   @default("")
  updatedAt   DateTime @updatedAt
}

model SprintSnapshot {
  sprintId   Int       @id
  name       String
  state      String
  startDate  DateTime
  endDate    DateTime
  result     String?
  computedAt DateTime?
  lastError  String?
  updatedAt  DateTime  @updatedAt
}

model SprintIssueEvents {
  sprintId  Int      @id
  issues    String
  fetchedAt DateTime
  labelPool String?
}

/// ElevenLabs keys the machines rotate over. Kept on the laptop DOCK only; the workspace DOCK reads and writes them there.
model ElevenLabsKey {
  name        String    @id
  key         String
  position    Int
  current     Boolean   @default(false)
  parkedUntil DateTime?
  createdAt   DateTime  @default(now())
}

/// A Discord forum thread the Discord page lists, saved by the Discord reader. Each sync sends the full set: a thread that is no longer sent gets removedAt.
model DiscordThread {
  id            String    @id
  payload       String
  lastActivity  DateTime
  lastMessageId String?
  updatedAt     DateTime
  removedAt     DateTime?
}

/// The owner dismissed a thread. It holds only while the thread's lastActivity is the one that was dismissed.
model DiscordThreadDismissal {
  threadId     String   @id
  lastActivity DateTime
  createdAt    DateTime
}

/// A Discord channel or thread the owner follows on the Discord page. kind is bug, uat, pr or follow.
model DiscordChannel {
  id      String   @id
  name    String?
  kind    String
  thread  Boolean
  enabled Boolean
  addedAt DateTime
  /// Brought by the workspace's team file: it cannot be removed, only switched off.
  team    Boolean  @default(false)
}

/// A review DOCK started on its own when the owner said "on it" in a pr-review thread: one per pull request head commit.
model AutoReview {
  id         String    @id @default(uuid())
  prUrl      String
  headSha    String
  ticketKey  String
  threadUrl  String
  sessionId  String?
  /// running, deciding, lgtm (approved by DOCK), clean (approve verdict, owner to LGTM), blockers, failed
  status     String    @default("running")
  detail     String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@unique([prUrl, headSha])
  @@index([ticketKey, startedAt])
  @@index([status])
}

/// Review findings DOCK sent back to the Task session: one per pr-review thread and last finding message, so a round reaches the session once.
model ReviewRound {
  id            String    @id @default(uuid())
  threadId      String
  ticketKey     String
  threadUrl     String
  /// JSON array of pull request urls
  prUrls        String
  /// JSON array of the finding message ids
  messageIds    String
  /// JSON array of the finding lines captured when the round was created
  findings      String?
  lastMessageId String
  lastMessageAt DateTime
  sessionId     String?
  opened        Boolean   @default(false)
  /// sending, sent, reported, answered, failed
  status        String    @default("sending")
  attempts      Int       @default(0)
  valid         Int?
  invalid       Int?
  pushed        Boolean?
  detail        String?
  createdAt     DateTime  @default(now())
  reportedAt    DateTime?

  @@unique([threadId, lastMessageId])
  @@index([threadId, lastMessageAt])
  @@index([sessionId])
  @@index([status])
}

/// A Keep / Problem / Try line of a sprint retro, drafted by sous and accepted, edited or closed by the owner.
model RetroItem {
  id        String   @id @default(uuid())
  sprint    String
  kind      String
  text      String
  evidence  String   @default("[]")
  dest      String   @default("note")
  status    String   @default("open")
  sessionId String?
  /// ledger for a line drafted from the ticket ledgers, judge for one the Judge sprint summary posted.
  source    String   @default("ledger")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sprint])
}

/// A session Judge reads: queued when it goes quiet, judged one at a time in the quiet window.
model JudgeSession {
  sessionId            String    @id
  /// The WIB date (YYYY-MM-DD) of the session's last judged message.
  day                  String
  status               String    @default("pending") /// pending | running | judged | failed
  judgedUntilMessageId Int?
  /// The last message id of the input the running Judge session reads.
  runUntilMessageId    Int?
  judgeChatId          String?
  grade                String?
  ownerWaitMinutes     Int       @default(0)
  attempts             Int       @default(0)
  startedAt            DateTime?
  judgedAt             DateTime?
  error                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([day])
}

/// One step Judge called a mistake (or not). ownerCall is the owner's answer on the day sheet; null keeps Judge's call.
model JudgeFinding {
  id         String   @id @default(uuid())
  sessionId  String
  day        String
  messageId  Int?
  threadUrl  String?
  cause      String
  text       String
  quote      String   @default("")
  shouldHave String   @default("")
  judgeCall  String /// mistake | not
  ownerCall  String? /// mistake | not
  note       String?
  createdAt  DateTime @default(now())

  @@index([sessionId])
  @@index([day])
  @@index([ownerCall, createdAt])
}

/// The owner's answer for one WIB day of findings.
model JudgeDay {
  day         String    @id
  confirmedAt DateTime?
  note        String?
}

/// One sprint's dependency map. sprint is the sprint name, like RetroItem.sprint.
model SprintPlan {
  sprint      String    @id
  status      String    @default("idle") /// idle | mapping | failed
  mappingKeys String    @default("[]") /// owner tickets the run in flight maps
  sessionId   String?
  mappedKeys  String    @default("[]")
  groups      String    @default("[]") /// [[keys safe in parallel]]
  error       String?
  startedAt   DateTime?
  mappedAt    DateTime?
  updatedAt   DateTime  @updatedAt
}

/// A ticket waits for dependsOnKey. Jira links are accepted on write; inferred ones wait for the owner.
model SprintPlanEdge {
  id           String    @id @default(uuid())
  sprint       String
  ticketKey    String
  dependsOnKey String
  source       String /// jira | inferred
  reason       String?
  state        String    @default("pending") /// pending | accepted | rejected
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([sprint, ticketKey, dependsOnKey])
  @@index([state])
}

/// A sprint being planned in Agents > Sprint > Planning, loaded from Jira and published back to it.
model SprintDraft {
  sprint      String    @id /// the Jira sprint name
  sprintId    Int
  status      String    @default("draft") /// draft | published
  sprintDays  Int       @default(10)
  startDate   DateTime?
  decisions   String    @default("{}") /// {findingId: {action, note, by, at}}
  qaReason    String? /// why there is no QA prediction, null when predict.mjs answered
  refStatuses String    @default("{}") /// {key: Jira status} of tickets the AC or links name outside the sprint
  drift       String    @default("{}") /// {findingId: {action, state, note, by, at}}: the owners' calls on held AC lines after publish
  storyboards String    @default("{}") /// {epic: {version, previous, path, page, frames, changed, changedAt, checkedAt, error}}
  questions   String    @default("[]") /// [{id, text, key, askedAt, answered, answeredBy, answeredAt}]: open questions the planning chat raised
  merges      String    @default("{}") /// {source: github|jira, tickets: {key: {merge, pulls}}}: GitHub merge state read on the last load
  createdBy   String?
  loadedAt    DateTime  @default(now())
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

/// One ticket of a SprintDraft: the planner's values next to what Jira held when it was loaded.
model SprintDraftTicket {
  draftSprint String
  key         String
  summary     String
  dev         String?
  sp          Float?
  wave        Int?
  planRank    Int? /// the number of the ticket's #N label in Jira: its place in the owner's plan
  ac          String  @default("[]") /// AC lines as planned
  jiraAc      String  @default("[]") /// AC lines as Jira held them at load or last publish
  jiraDev     String?
  dependsOn   String  @default("[]")
  status      String
  prediction  String? /// {prediction, reasons, fix}
  epic        String?
  frames      String  @default("[]") /// storyboard frames (F<n>.<m>) the AC or the description names
  tcs         String  @default("[]") /// [{id, ac, title, steps, expected}]: the draft test cases
  tcAt        DateTime? /// when the test cases were last written
  tcPosted    String? /// the test cases of the last QONFLO-TC v1 comment posted on the ticket
  position    Int     @default(0)

  @@id([draftSprint, key])
}
