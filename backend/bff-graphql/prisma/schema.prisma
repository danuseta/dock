generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TicketCache {
  id String @id @default(uuid())
  key String @unique
  summary String
  description String?
  status String
  assignee String?
  reporter String?
  priority String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
}

model PullRequestCache {
  id String @id @default(uuid())
  number Int
  title String
  description String?
  state String
  url String
  author String
  repository String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mergedAt DateTime?
  @@unique([repository, number])
  @@index([repository])
  @@index([state])
}

model DemoLink {
  id String @id @default(uuid())
  ticketKey String @unique
  url String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketDependency {
  id           String   @id @default(uuid())
  ticketKey    String   @unique
  dependsOnKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([dependsOnKey])
}

model QuickLink {
  id String @id @default(uuid())
  title String
  url String
  color String @default("#60a5fa")
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([position])
}

model MonitorTarget {
  id             String    @id @default(uuid())
  name           String
  url            String
  expectedStatus Int       @default(200)
  timeoutMs      Int       @default(5000)
  lastStatus     String?
  lastStatusCode Int?
  lastLatencyMs  Int?
  lastCheckedAt  DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([name])
}

model AppSettings {
  id String @id @default(uuid())
  key String @unique
  value String
  description String?
  updatedAt DateTime @updatedAt
}

model CacheEntry {
  key String @id
  value String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([expiresAt])
}

model MonitoredRepository {
  id String @id @default(uuid())
  owner String
  name String
  webhookSecret String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([owner, name])
}

model OrchestratorRun {
  key              String    @id
  title            String    @default("")
  stage            String
  waiting          String    @default("")
  payload          String
  activity         String    @default("IDLE")
  activityDetail   String?
  activityEndedAt  DateTime?
  lastEventAt      DateTime?
  ledgerUpdatedAt  DateTime  @default(now())
  transcriptAt     DateTime?
  dismissedAt      DateTime?
  machine          String    @default("laptop")
  ledgerRaw        String?
  handover         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([stage])
}

model OrchestratorEvent {
  id        String   @id @default(uuid())
  ticketKey String
  kind      String
  detail    String?
  createdAt DateTime @default(now())

  @@index([ticketKey, createdAt])
}

model IngestToken {
  id         String    @id @default(uuid())
  name       String
  prefix     String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  machine    String    @default("laptop")
  createdAt  DateTime  @default(now())
}

model OrchestratorToolEvent {
  id        Int      @id @default(autoincrement())
  ticketKey String
  kind      String
  agentId   String   @default("main")
  agentType String?
  name      String
  detail    String?
  at        DateTime

  @@index([ticketKey, id])
}

model ChatSession {
  id              String    @id
  source          String
  machine         String    @default("laptop")
  title           String    @default("")
  ticketKey       String?
  forkFrom        String?
  claudeSessionId String?
  status          String    @default("idle")
  statusDetail    String?
  messageCount    Int       @default(0)
  startedAt       DateTime
  lastMessageAt   DateTime
  lastDeltaAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([source, lastMessageAt])
  @@index([ticketKey])
  @@index([machine, status])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  sessionId String
  role      String
  text      String
  state     String   @default("done")
  at        DateTime

  @@index([sessionId, id])
  @@index([state])
}

model ChatActivity {
  id        Int       @id @default(autoincrement())
  sessionId String
  turnId    Int
  eventId   String
  parentId  String?
  kind      String
  agent     String    @default("main")
  name      String
  label     String    @default("")
  summary   String    @default("")
  detail    String?
  status    String    @default("running")
  seq       Int
  startedAt DateTime
  endedAt   DateTime?

  @@unique([sessionId, turnId, eventId])
  @@index([sessionId, seq])
  @@index([startedAt])
}

model SprintSnapshot {
  sprintId   Int       @id
  name       String
  state      String
  startDate  DateTime
  endDate    DateTime
  result     String?
  computedAt DateTime?
  lastError  String?
  updatedAt  DateTime  @updatedAt
}

model SprintIssueEvents {
  sprintId  Int      @id
  issues    String
  fetchedAt DateTime
  labelPool String?
}
