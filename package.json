{
  "name": "dock-monorepo",
  "version": "1.0.1",
  "private": true,
  "description": "DOCK - Development Operations Control Kit",
  "workspaces": [
    "frontend",
    "backend/bff-graphql"
  ],
  "scripts": {
    "build:app": "npm run build --workspace=frontend && npm run build --workspace=backend/bff-graphql",
    "build:all": "npm run build --workspaces --if-present",
    "test:all": "npm test --workspaces --if-present"
  },
  "keywords": [
    "dock",
    "kanban",
    "jira",
    "github",
    "monorepo"
  ],
  "author": "DOCK",
  "license": "MIT"
}
