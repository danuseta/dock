{
  "name": "jidis-monorepo",
  "version": "1.0.1",
  "private": true,
  "description": "JIDIS - Developer Task & PR Pipeline Kanban Dashboard Monorepo",
  "workspaces": [
    "frontend",
    "electron",
    "backend/bff-graphql",
    "backend/jira-service",
    "backend/github-service",
    "backend/discord-service",
    "backend/storage-service"
  ],
  "scripts": {
    "bump": "node scripts/autobump-version.mjs",
    "bump:patch": "node scripts/autobump-version.mjs patch",
    "bump:minor": "node scripts/autobump-version.mjs minor",
    "bump:major": "node scripts/autobump-version.mjs major",
    "build:app": "npm run build --workspace=frontend && npm run build --workspace=backend/bff-graphql",
    "build:all": "npm run build --workspaces --if-present",
    "test:all": "npm test --workspaces --if-present"
  },
  "keywords": [
    "jidis",
    "kanban",
    "jira",
    "github",
    "monorepo"
  ],
  "author": "JIDIS Engineering Team",
  "license": "MIT"
}
