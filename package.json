{
  "name": "dock-monorepo",
  "version": "1.0.1",
  "private": true,
  "bin": {
    "dock-setup": "tools/dock-setup.mjs"
  },
  "description": "DOCK - Development Operations Control Kit",
  "workspaces": [
    "frontend",
    "backend/bff-graphql"
  ],
  "scripts": {
    "setup": "node tools/dock-setup.mjs",
    "build:app": "npm run build --workspace=frontend && npm run build --workspace=backend/bff-graphql",
    "build:all": "npm run build --workspaces --if-present",
    "test:all": "npm test --workspaces --if-present",
    "seed:e2e": "npm run seed:e2e --workspace=backend/bff-graphql --",
    "demo:mock": "node tools/e2e/start.mjs --with-bridge",
    "e2e:mock": "node tools/e2e/run.mjs"
  },
  "keywords": [
    "dock",
    "kanban",
    "jira",
    "github",
    "monorepo"
  ],
  "author": "DOCK",
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.49.1"
  }
}
